CAPI=2:

name: "x-heep:ip:xheep_obi_to_axi_bridge"
description: "X-HEEP flat OBI to PULP AXI OBI bridge wrapper."


filesets:
  rtl:
    depend:
    - x-heep::packages
    - pulp-platform.org::obi
    - pulp-platform.org::axi
    - pulp-platform.org::axi_obi
    files:
    - rtl/xheep_obi_to_axi_bridge_pkg.sv
    - rtl/xheep_obi_to_axi_bridge.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
    - rtl
