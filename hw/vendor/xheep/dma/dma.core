CAPI=2:

name: "x-heep:ip:dma"
description: "core-v-mini-mcu dma channel"

# Copyright 2021 OpenHW Group
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1

filesets:
  files_rtl:
    depend:
      - pulp-platform.org::common_cells
      - pulp-platform.org::register_interface
      - xheep:util:reg-generator
    files:
    - rtl/dma_pkg.sv
    - rtl/dma_units/dma_processing_unit.sv
    - rtl/dma_units/dma_read_unit.sv
    - rtl/dma_units/dma_read_addr_unit.sv
    - rtl/dma_units/dma_write_unit.sv
    - rtl/dma_units/dma_buffer_unit/dma_buffer_fifos.sv
    - rtl/dma_units/dma_buffer_unit/dma_buffer_control.sv
    - rtl/dma_units/dma_buffer_unit/dma_buffer_unit.sv
    - rtl/dma.sv
    - rtl/dma_subsystem/dma_subsystem.sv
    - rtl/dma_subsystem/dma_NtoM_xbar.sv
    file_type: systemVerilogSource
  
  files_verilator_waiver:
    files:
      - dma.vlt
    file_type: vlt

generate:
  dma:
    generator: regtool
    parameters:
      config:           data/xheep_dma.hjson
      name:             dma
      rtl_dir:          rtl
      sw_path:          sw/dma_regs.h
      doc_path:         docs/dma_regs.md
      structs_sw_path:  sw/dma_structs.h

targets:
  default:
    filesets:
    - files_rtl
    - tool_verilator ? (files_verilator_waiver)
    generate:
    - dma
