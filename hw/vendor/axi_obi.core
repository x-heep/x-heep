name: pulp-platform.org::axi_obi
description: OBI to AXI protocol bridge from pulp-platform/axi_obi.

filesets:
  obi_to_axi:
    depend:
    - pulp-platform.org::obi
    - pulp-platform.org::common_cells
    - pulp-platform.org::axi
    files:
    - pulp_platform/axi_obi/src/obi_to_axi.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
    - obi_to_axi

  obi_to_axi:
    filesets:
    - obi_to_axi
