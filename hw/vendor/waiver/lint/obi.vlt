`verilator_config

lint_off -rule ASCRANGE -file "*/xheep_obi_pkg.sv"

lint_off -rule UNUSEDSIGNAL -file "*/cpu_subsystem.sv" -match "*'core_instr_resp_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/cpu_subsystem.sv" -match "*'core_data_resp_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/xbar_varlat_one_to_n.sv" -match "*'master_req_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/xbar_varlat_n_to_one.sv" -match "*'slave_resp_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/obi_to_picorv32.sv" -match "*'obi_req_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/xheep_obi_fifo.sv" -match "*'producer_req_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/xheep_obi_fifo.sv" -match "*'consumer_resp_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/ao_peripheral_subsystem.sv" -match "*'slave_fifoout_req'*"

lint_off -rule UNOPTFLAT -file "*/relobi_demux.sv" -match "*demux_xbar_i*"
