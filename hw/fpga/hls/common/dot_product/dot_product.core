# HLS dot-product accelerator example, wrapped for X-HEEP OBI.
#
# This core is what the testbench / FPGA top depend on (behind the
# `use_hls_example` flag, see core-v-mini-mcu.core and tb/x-heep-tb-utils.core).
# It holds everything that is independent of the HLS tool -- the OBI wrapper
# and its AXI<->OBI bridges -- and pulls in the tool-specific part according
# to a second flag, which also decides which tool's RTL gets generated by the
# pre-build hook:
#
#   --flag use_hls_example --flag use_vitis_hls       Vitis HLS  (epfl:ip:dot_product_vitis)
#   --flag use_hls_example --flag use_bambu_hls       Bambu HLS  (epfl:ip:dot_product_bambu)
#   --flag use_hls_example --flag use_dynamatic_hls   Dynamatic  (epfl:ip:dot_product_dynamatic)
#
# Exactly one of use_vitis_hls / use_bambu_hls / use_dynamatic_hls must be
# given. Each flow provides a 'dot_product_hls_adapter' module with the same
# ports, which is what dot_product_xheep_wrapper instantiates; with no tool
# flag the adapter is missing and the build fails on the unresolved module.

name: "epfl:ip:dot_product"
description: "HLS-generated streaming dot-product accelerator, wrapped for X-HEEP OBI (HLS tool selected by flag)."

filesets:
  files_rtl:
    depend:
    - x-heep::packages
    - pulp-platform.org::obi
    - pulp-platform.org::axi
    - pulp-platform.org::axi_obi
    - x-heep:ip:xheep_obi_to_axi_bridge
    - x-heep:ip:xheep_axi_to_obi_bridge
    - use_vitis_hls ? (epfl:ip:dot_product_vitis)
    - use_bambu_hls ? (epfl:ip:dot_product_bambu)
    - use_dynamatic_hls ? (epfl:ip:dot_product_dynamatic)
    files:
    - dot_product_xheep_wrapper.sv
    file_type: systemVerilogSource

  verilator-waiver:
    files:
    - dot_product.vlt
    file_type: vlt

targets:
  default:
    filesets:
    - files_rtl
    - tool_verilator ? (verilator-waiver)
