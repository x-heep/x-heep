`verilator_config

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'dma_done_i'*"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'dma_ready_i'*"
lint_off -rule PINMISSING -file "*/tb/testharness.sv" -match "Cell has missing pin: 'w25q128jw_controller_done_o'"
lint_off -rule PINMISSING -file "*/x_heep_system.sv" -match "Cell has missing pin: 'w25q128jw_controller_done_o'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Bits of signal are not driven: 'hw2*"
lint_off -rule UNUSED   -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'reg2hw'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'reg2hw'*"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'dma_size'[31:16]*"
lint_off -rule DECLFILENAME -file "*/w25q128jw_controller_reg_top.sv"
lint_off -rule WIDTH -file "*/w25q128jw_controller_reg_top.sv" -match "Operator ASSIGNW expects *"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'external_spi_host_hw2reg_status_i*"
lint_off -rule UNUSED -file "*/w25q128jw_controller_reg_top.sv" -match "Parameter is not used: 'AW'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'cache_dma_resp'"
lint_off -rule WIDTHEXPAND  -file "*/w25q128jw_controller.sv" -match "*W25Q128JW_CONTROLLER_CACHE_DATA_OFFSET*"
lint_off -rule UNUSEDSIGNAL -file "*/flash_llc_cache.sv"                -match "Bits of signal are not used: 'dma_req_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/flash_llc_cache.sv"                -match "Bits of signal are not used: 'pwr_ctrl_i'*"
lint_off -rule UNUSEDSIGNAL -file "*/flash_llc_cache_way.sv"            -match "Bits of signal are not used: 'request_i'*"
// Width and unused-signal waivers for cache code paths (exposed when CACHE_EN ifdef was replaced with parameter)
lint_off -rule WIDTHTRUNC   -file "*/w25q128jw_controller.sv"
lint_off -rule WIDTHEXPAND  -file "*/w25q128jw_controller.sv"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'src_ptr_inc'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'dst_ptr_inc'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'rx_trigger_slot'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'tx_trigger_slot'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'cache_dma_resp'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'slot_wait_counter'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'cache_ctrl_req'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'cache_dma_req'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'cache_req'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'cache_data_bus_we'*"
lint_off -rule UNUSEDPARAM -file "*/w25q128jw_controller.sv" -match "Parameter is not used: 'W25Q128JW_CONTROLLER_START_ADDRESS'*"
lint_off -rule UNUSEDSIGNAL -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'llc_cache_pwr_ctrl_i'*"
