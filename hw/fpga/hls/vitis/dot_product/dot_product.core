    depend:
    - x-heep::packages
    - pulp-platform.org::obi
    - pulp-platform.org::axi
    - pulp-platform.org::axi_obi
    - x-heep:ip:xheep_obi_to_axi_bridge
    - x-heep:ip:xheep_axi_to_obi_bridge
    files:
    - rtl/hls/dot_product_CTRL_s_axi.v
    - rtl/hls/dot_product_dot_product_Pipeline_dot_product_loop.v
    - rtl/hls/dot_product_flow_control_loop_pipe_sequential_init.v
    - rtl/hls/dot_product_gmem_a_m_axi.v
    - rtl/hls/dot_product_gmem_b_m_axi.v
    - rtl/hls/dot_product_mul_32s_32s_64_3_1.v
    - rtl/hls/dot_product.v
    - rtl/dot_product_xheep_wrapper.sv
    file_type: systemVerilogSource

  verilator-waiver:
    files:
    - dot_product.vlt
    file_type: vlt

targets:
  default:
    filesets:
    - files_rtl
    - tool_verilator ? (verilator-waiver)
