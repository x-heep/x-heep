CAPI=2:

name: "example:ip:dlc"
description: "digital level crossing block"

# Copyright 2024 EPFL
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1


filesets:
  files_rtl:
    depend:
      - x-heep::packages
    files:
    - rtl/dlc_reg_pkg.sv
    - rtl/dlc_reg_top.sv
    - rtl/dlc.sv
    file_type: systemVerilogSource

  verilator-waiver:
    files:
    - dlc.vlt
    file_type: vlt

targets:
  default:
    filesets:
    - files_rtl
    - tool_verilator ? (verilator-waiver)
